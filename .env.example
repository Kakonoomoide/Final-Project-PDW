# ====================================================================
# SERVER
# ====================================================================
PORT=3000
APP_NAME=TrAvelIt

# session buat login (admin & user pake mekanisme yang sama)
SESSION_SECRET=ganti-dengan-secret-random-punya-kalian

# ====================================================================
# DATABASE (SQLite - otomatis kebuat sendiri, gak perlu setup apa-apa)
# ====================================================================
DB_STORAGE=./database.sqlite

# ====================================================================
# GEMINI AI - dipake di:
# - M1: narasiin rekomendasi waktu berkunjung (dikombinasi sama data cuaca)
# - M2: rekomendasi caption artikel wisata
# - M3: AI destination finder (quiz)
# - M4: rekomendasi deskripsi destinasi
# - M5: generate itinerary (JSON terstruktur), chat asisten perjalanan,
#       identifikasi tempat dari foto
# Ambil gratis di https://aistudio.google.com/app/apikey
# SEMUA mahasiswa pake API key yang SAMA (1 aja per tim/project)
#
# SOAL PILIHAN MODEL - penting, baca sebelum ngubah:
# Kuota free tier dihitung PER MODEL, dan model flash flagship terbaru
# jatahnya cuma ~20 request/HARI. Buat project yang dipake 5 orang
# bareng-bareng, itu habis dalam hitungan menit.
#
# Makanya defaultnya `gemini-3.5-flash-lite`: jatah hariannya jauh lebih
# besar, dan udah dites sanggup ngerjain semua fitur di project ini
# termasuk yang paling berat (generate itinerary JSON & baca foto).
#
# Kalau kena "Kuota AI lagi habis", gak perlu nunggu tengah malam -
# ganti aja ke model lain di sini (misal gemini-3.1-flash-lite atau
# gemini-3.8-flash), kuotanya kehitung terpisah.
#
# CATATAN: gemini-2.5-flash-lite SUDAH DIPENSIUNKAN buat pengguna baru,
# Google sendiri nyuruh pindah ke gemini-3.5-flash-lite.
# ====================================================================
GEMINI_API_KEY=isi-api-key-kalian-disini
GEMINI_MODEL=gemini-3.5-flash-lite

# ====================================================================
# WEATHER API - dipake M1 (cuaca di kota tujuan, buat narasi
# "enaknya berangkat kapan")
# Contoh: OpenWeatherMap (https://openweathermap.org/api), gratis tier ada
# ====================================================================
WEATHER_API_KEY=isi-api-key-cuaca-disini

# ====================================================================
# NOMINATIM (OpenStreetMap) - dipake M5 buat verifikasi koordinat tempat
# hasil AI & reverse geocode tombol "pakai lokasi saya".
#
# GAK BUTUH API KEY. Dua baris di bawah biasanya GAK PERLU DIUBAH -
# cuma diisi kalau kalian nge-host instance Nominatim sendiri.
# User-Agent wajib jelas, itu syarat pemakaian Nominatim.
# ====================================================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TrAvelIt/1.0 (final project PDW)
